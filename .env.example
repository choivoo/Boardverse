# Boardverse server configuration (all optional for local development)
# PORT=8787                           # HTTP + WebSocket port
# DATABASE_PATH=./data/boardverse.db  # SQLite file (accounts, ratings, games, clubs, tournaments). ':memory:' = throwaway.
# NODE_ENV=production                 # production: dev outbox disabled; email features OFF unless SMTP_URL is set
# PUBLIC_URL=https://boardverse.example # absolute base URL used in emailed links (required when SMTP_URL is set)
# SMTP_URL=smtps://user:password@smtp.example.com:465   # enables real verification / password-reset email
# MAIL_FROM="Boardverse <no-reply@boardverse.example>"
# ADMIN_EMAILS=you@example.com        # comma list; admin = listed AND verified email. Without SMTP use: npx tsx scripts/verify-user.ts you@example.com
# COOKIE_SECURE=1                     # force Secure cookies/HSTS (otherwise detected from X-Forwarded-Proto: https)
