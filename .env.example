# Boardverse configuration (all optional for local development)
#
# ---- Node server / Docker ----
# PORT=8787                           # HTTP + WebSocket port
# DATABASE_PATH=./data/boardverse.db  # SQLite file. ':memory:' = throwaway.
# NODE_ENV=production                 # production: dev outbox disabled; email features OFF unless SMTP_URL is set
# PUBLIC_URL=https://boardverse.example # absolute base URL used in emailed links (required when SMTP_URL is set)
# SMTP_URL=smtps://user:password@smtp.example.com:465   # real verification / password-reset email (Node/Docker only)
# MAIL_FROM="Boardverse <no-reply@boardverse.example>"
# COOKIE_SECURE=1                     # force Secure cookies/HSTS (otherwise detected from X-Forwarded-Proto: https)
#
# ---- both Node and Cloudflare (on Cloudflare set them as Worker secrets/variables, never in wrangler.toml) ----
# ADMIN_EMAILS=you@example.com        # comma list; admin = listed AND verified email
# OPERATOR_TOKEN=<random string, >= 24 chars>  # enables POST /api/operator/verify-email (Authorization: Bearer <token>) for deployments without SMTP / DB shell
#
# ---- build-time ----
# VITE_ENGINE=0                       # build WITHOUT the Stockfish (GPL-3.0) analysis engine
